{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "🖥️ Launch Interactive Visual Dashboard",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}\\dashboard.py",
            "console": "integratedTerminal"
        },
        {
            "name": "🚀 RUN ALL 4 WORKFLOWS (Complete Suite)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}\\run_all.py",
            "console": "integratedTerminal"
        },
        {
            "name": "1. Run Multi-Agent Pipeline (Main)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}\\main.py",
            "args": ["--defect", "crack", "--frame", "101"],
            "console": "integratedTerminal"
        },
        {
            "name": "2. Run Self-Healing Demo (All 4 Scenarios)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}\\demo_self_healing.py",
            "console": "integratedTerminal"
        },
        {
            "name": "3. Run 5-Frame Factory Stream Simulation",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}\\run_simulation.py",
            "console": "integratedTerminal"
        },
        {
            "name": "4. Run Pytest Suite",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "args": ["tests/", "-v"],
            "console": "integratedTerminal"
        }
    ]
}
